{
  "name": "@forge/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "mkdir -p src/generated && cp ../../target/idl/forge.json src/generated/forge.json && cp ../../target/types/forge.ts src/generated/forge.ts && tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@forge/config": "workspace:*",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "nx": {
    "implicitDependencies": [
      "onchain"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/src/generated"
        ]
      },
      "check-types": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {
    "@solana/kit": "8.4.0"
  }
}
