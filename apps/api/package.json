{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts all",
    "start:api": "bun src/main.ts api",
    "start:worker": "bun src/main.ts worker",
    "migrate": "bun src/cli.ts migrate",
    "check-types": "tsc --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "@forge/sdk": "workspace:*",
    "@solana/kit": "8.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forge/config": "workspace:*",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "nx": {
    "targets": {
      "check-types": {
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
