{
  "name": "@forge/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun build ./index.html --outdir dist --minify",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@forge/sdk": "workspace:*",
    "@solana/kit": "8.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@forge/config": "workspace:*",
    "@types/bun": "^1.3.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^6.0.3"
  },
  "nx": {
    "targets": {
      "build": { "dependsOn": ["^build"], "outputs": ["{projectRoot}/dist"] },
      "check-types": { "dependsOn": ["^build"] }
    }
  }
}
