{
  "name": "forge",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev --parallel=4",
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "test": "nx run-many -t test",
    "graph": "nx graph",
    "dev:banking": "nx dev banking",
    "dev:native": "nx run-many -t dev --projects=native",
    "dev:web": "nx run-many -t dev --projects=web",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "ultracite check apps packages *.json *.jsonc *.ts",
    "fix": "ultracite fix apps packages *.json *.jsonc *.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forge/config": "workspace:*",
    "@types/node": "catalog:",
    "nx": "^23.2.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^6.0.3",
    "ultracite": "7.11.0",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.3.13"
}
